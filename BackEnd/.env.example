# CJack Backend Environment Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Simulation Mode
# When true, all sensors, vitals, and CPR systems produce realistic simulated streams
SIMULATION_MODE=true

# Security token for ESP32 / TTGO T-Beam hardware telemetry ingestion
HARDWARE_API_KEY=cjack_dev_hw_key_2026

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# MongoDB Connection String (fallback to in-memory store if unavailable)
MONGODB_URI=mongodb://localhost:27017/cjack_db

# Twilio Telephony Integration (for automated Real Emergency Voice Calls)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
EMERGENCY_PHONE_NUMBER=+919876543210
